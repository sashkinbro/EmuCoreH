<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Firmware is supplied by the user on each device, never backed up. -->
    <exclude domain="file" path="jgenesis/system/" />
    <exclude domain="sharedpref" path="bios_import_migrations.xml" />
    <!-- A loopback proxy is device-local transient state and must never migrate. -->
    <exclude domain="sharedpref" path="retroachievements_host_override.xml" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
